class Win_3 {
    JFrame frame3;
    JPanel panel3;

    JButton buttonDone;
    JButton buttonDraw;
    JButton buttonNext;
    JButton buttonRestart;

    JButton[][] buttons = new JButton[3][3];

    boolean isXTurn = true;
    private Win_4 W_4;  // Reference to Win_4 for navigation

    public void setNextWindow(Win_4 W_4) {
        this.W_4 = W_4;
    }

    public void Wind_3() {
        frame3 = new JFrame("Tic-Tac-Toe Game");
        frame3.setSize(600, 500);
        frame3.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame3.setLayout(null);
        frame3.setLocationRelativeTo(null);

        // Main game board panel
        panel3 = new JPanel();
        panel3.setBounds(150, 20, 300, 300);
        panel3.setLayout(new GridLayout(3, 3));
        panel3.setBorder(BorderFactory.createLineBorder(Color.BLACK, 2));
        frame3.add(panel3);

        // Control buttons panel
        JPanel controlPanel = new JPanel();
        controlPanel.setBounds(100, 350, 400, 100);
        controlPanel.setLayout(new FlowLayout(FlowLayout.CENTER, 20, 10));
        frame3.add(controlPanel);

        // Game buttons
        buttonDone = new JButton("Done");
        buttonDone.setOpaque(true);
        buttonDone.setBackground(new Color(0, 200, 83));
        buttonDone.setFocusable(false);
        buttonDone.addActionListener(e -> endGame());

        buttonDraw = new JButton("Draw");
        buttonDraw.setOpaque(true);
        buttonDraw.setBackground(new Color(0, 123, 255));
        buttonDraw.setFocusable(false);
        buttonDraw.addActionListener(e -> declareDraw());

        buttonNext = new JButton("Next");
        buttonNext.setOpaque(true);
        buttonNext.setBackground(new Color(0, 180, 180));
        buttonNext.setFocusable(false);
        buttonNext.addActionListener(e -> {
            if (W_4 != null) {
                W_4.Wind_4();
                frame3.dispose();
            }
        });

        buttonRestart = new JButton("Restart");
        buttonRestart.setOpaque(true);
        buttonRestart.setBackground(new Color(255, 191, 0));
        buttonRestart.setFocusable(false);
        buttonRestart.addActionListener(e -> restartGame());

        controlPanel.add(buttonDone);
        controlPanel.add(buttonDraw);
        controlPanel.add(buttonRestart);
        controlPanel.add(buttonNext);

        // Initialize game board
        Font font = new Font("Arial", Font.BOLD, 60);
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                buttons[i][j] = new JButton("");
                buttons[i][j].setFont(font);
                buttons[i][j].setFocusable(false);
                buttons[i][j].addActionListener(new ButtonClickListener(i, j));
                panel3.add(buttons[i][j]);
            }
        }

        frame3.setVisible(true);
    }

    private class ButtonClickListener implements ActionListener {
        private int row, col;

        public ButtonClickListener(int row, int col) {
            this.row = row;
            this.col = col;
        }

        @Override
        public void actionPerformed(ActionEvent e) {
            JButton button = buttons[row][col];
            if (button.getText().equals("")) {
                button.setText(isXTurn ? "X" : "O");
                isXTurn = !isXTurn;
                checkGameStatus();
            }
        }
    }

    private void checkGameStatus() {
        // Check for win conditions
        if (checkWin("X")) {
            JOptionPane.showMessageDialog(frame3, "X Wins!");
            disableAllButtons();
        } else if (checkWin("O")) {
            JOptionPane.showMessageDialog(frame3, "O Wins!");
            disableAllButtons();
        } else if (isBoardFull()) {
            JOptionPane.showMessageDialog(frame3, "It's a Draw!");
        }
    }

    private boolean checkWin(String symbol) {
        // Check rows
        for (int i = 0; i < 3; i++) {
            if (buttons[i][0].getText().equals(symbol) &&
                    buttons[i][1].getText().equals(symbol) &&
                    buttons[i][2].getText().equals(symbol)) {
                return true;
            }
        }

        // Check columns
        for (int j = 0; j < 3; j++) {
            if (buttons[0][j].getText().equals(symbol) &&
                    buttons[1][j].getText().equals(symbol) &&
                    buttons[2][j].getText().equals(symbol)) {
                return true;
            }
        }

        // Check diagonals
        if (buttons[0][0].getText().equals(symbol) &&
                buttons[1][1].getText().equals(symbol) &&
                buttons[2][2].getText().equals(symbol)) {
            return true;
        }

        return buttons[0][2].getText().equals(symbol) &&
                buttons[1][1].getText().equals(symbol) &&
                buttons[2][0].getText().equals(symbol);
    }

    private boolean isBoardFull() {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (buttons[i][j].getText().equals("")) {
                    return false;
                }
            }
        }
        return true;
    }

    private void disableAllButtons() {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                buttons[i][j].setEnabled(false);
            }
        }
    }

    private void enableAllButtons() {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                buttons[i][j].setEnabled(true);
            }
        }
    }

    private void endGame() {
        int choice = JOptionPane.showConfirmDialog(frame3,
                "Are you sure you want to end the current game?",
                "End Game",
                JOptionPane.YES_NO_OPTION);
        if (choice == JOptionPane.YES_OPTION) {
            frame3.dispose();
        }
    }

    private void declareDraw() {
        int choice = JOptionPane.showConfirmDialog(frame3,
                "Declare this game as a draw?",
                "Draw Game",
                JOptionPane.YES_NO_OPTION);
        if (choice == JOptionPane.YES_OPTION) {
            JOptionPane.showMessageDialog(frame3, "Game declared as draw!");
            disableAllButtons();
        }
    }

    private void restartGame() {
        int choice = JOptionPane.showConfirmDialog(frame3,
                "Are you sure you want to restart the game?",
                "Restart Game",
                JOptionPane.YES_NO_OPTION);
        if (choice == JOptionPane.YES_OPTION) {
            for (int i = 0; i < 3; i++) {
                for (int j = 0; j < 3; j++) {
                    buttons[i][j].setText("");
                }
            }
            enableAllButtons();
            isXTurn = true;
        }
    }
}

